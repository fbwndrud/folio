{
  "name": "folio",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Local MCP tools for managing manuscripts, assets, sources and review history.",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "setup": "npm ci && npm --prefix viewer ci && npm --prefix viewer run build",
    "viewer": "node bin/folio-view.js",
    "doctor": "node bin/folio-doctor.js",
    "preview": "node bin/folio-view.js --preview",
    "test": "node --test --test-concurrency=2 \"test/**/*.test.js\"",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "examples": "node examples/run.js all",
    "examples:bundle": "node scripts/example-bundle.js",
    "examples:verify": "node examples/run.js all --verify && node examples/tracking.js",
    "assets:verify": "node examples/assets.js",
    "package:verify": "node scripts/build-package.js --verify",
    "production:verify": "node examples/production.js",
    "benchmark:local": "node scripts/benchmark-local.js",
    "package:build": "node scripts/build-package.js"
  },
  "files": [
    "bin/",
    "adapters/",
    "core/",
    "server/",
    "packs/",
    "skill/",
    "examples/",
    "scripts/",
    "docs/*.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "NOTICE",
    "viewer/dist/",
    "README.ko.md",
    "licenses/"
  ],
  "bin": {
    "folio-doctor": "bin/folio-doctor.js",
    "folio-mcp": "bin/folio-mcp.js",
    "folio-view": "bin/folio-view.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.12.0",
    "globals": "^15.9.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fbwndrud/folio.git"
  },
  "bugs": {
    "url": "https://github.com/fbwndrud/folio/issues"
  },
  "homepage": "https://github.com/fbwndrud/folio#readme"
}
